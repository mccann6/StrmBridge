{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "MediaOutputPath": "/app/media",
    "SyncIntervalSeconds": 300,
    "DatabasePath": "/app/data/linker.db",
    "ServiceBaseUrl": "http://localhost:9847"
  },

  "Providers": {
    "Torbox": {
      "IsEnabled": true,
      "ApiBaseUrl": "https://api.torbox.app",
      "ApiKey": ""
    }
  }
}
